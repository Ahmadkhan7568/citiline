<ui:FluentWindow x:Class="Citiline.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Citiline ERP - Advertising Agency Solution" 
        Height="800" Width="1280"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />   <!-- logo -->
                    <RowDefinition Height="*" />       <!-- nav -->
                    <RowDefinition Height="Auto" />   <!-- settings -->
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0" Margin="24,32,24,24">
                    <TextBlock Text="CITILINE" FontSize="22" FontWeight="Black" Foreground="#0F172A" />
                    <TextBlock Text="ADVERTISING ERP" FontSize="9" FontWeight="Bold" Foreground="#64748B" />
                </StackPanel>

                <!-- Main Nav -->
                <ListBox Grid.Row="1" x:Name="SidebarList" Background="Transparent" BorderThickness="0"
                         Padding="12,0" SelectionChanged="SidebarList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                                CornerRadius="8" Padding="14,11" Margin="0,2">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#EDE9FE" />
                                                <Setter Property="Foreground" Value="#7C3AED" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#F1F5F9" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBoxItem Tag="dashboard" IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Home24" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock Text="Dashboard" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="invoices">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DocumentText24" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock Text="Sales Invoices" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="employees">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="People24" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock Text="Employee (HR)" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="payroll">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Money24" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock Text="Payroll &amp; Salaries" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="ledger">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Book24" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock Text="Financial Ledger" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="customers">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ContactCard24" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock Text="Customer CRM" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <!-- Bottom: separator + Settings -->
                <StackPanel Grid.Row="2" Margin="12,0,12,16">
                    <Separator Background="#E2E8F0" Margin="0,0,0,8" />
                    <ListBox x:Name="BottomNav" Background="Transparent" BorderThickness="0"
                             SelectionChanged="BottomNav_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="BB" Background="{TemplateBinding Background}"
                                                    CornerRadius="8" Padding="14,11" Margin="0,1">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="BB" Property="Background" Value="#EDE9FE" />
                                                    <Setter Property="Foreground" Value="#7C3AED" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="BB" Property="Background" Value="#F1F5F9" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBoxItem Tag="settings">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Settings24" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Text="Settings" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Frame -->
        <Frame x:Name="RootFrame" Grid.Column="1" NavigationUIVisibility="Hidden" />
    </Grid>
</ui:FluentWindow>
