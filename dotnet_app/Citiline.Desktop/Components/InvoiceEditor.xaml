<UserControl x:Class="Citiline.Desktop.Components.InvoiceEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="White">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Editor Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Edit Invoice" FontSize="20" FontWeight="Bold" />
            <ui:Button Icon="Dismiss24" HorizontalAlignment="Right" Appearance="Secondary" Padding="8" />
        </Grid>

        <!-- Main Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Customer" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ui:TextBox PlaceholderText="Select Customer..." />
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Invoice Number" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ui:TextBox Text="INV-2024-001" IsEnabled="False" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Line Items" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ui:CardControl Padding="0" Margin="0,0,0,24">
                    <ui:DataGrid AutoGenerateColumns="False" BorderThickness="0">
                        <ui:DataGrid.Columns>
                            <DataGridTextColumn Header="Description" Width="*" />
                            <DataGridTextColumn Header="Qty" Width="80" />
                            <DataGridTextColumn Header="Unit Price" Width="120" />
                            <DataGridTextColumn Header="Tax" Width="100" />
                            <DataGridTextColumn Header="Total" Width="120" />
                        </ui:DataGrid.Columns>
                    </ui:DataGrid>
                </ui:CardControl>

                <!-- Totals -->
                <StackPanel HorizontalAlignment="Right" Width="250">
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Subtotal" Foreground="#64748B" />
                        <TextBlock Text="₨ 0.00" HorizontalAlignment="Right" FontWeight="SemiBold" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Sales Tax (18%)" Foreground="#64748B" />
                        <TextBlock Text="₨ 0.00" HorizontalAlignment="Right" FontWeight="SemiBold" />
                    </Grid>
                    <Separator Margin="0,8" Opacity="0.1" />
                    <Grid>
                        <TextBlock Text="Grand Total" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="₨ 0.00" FontSize="16" FontWeight="Black" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <ui:Button Content="Discard Changes" Appearance="Secondary" Margin="0,0,12,0" />
            <ui:Button Content="Save &amp; Sync to FBR" Appearance="Primary" Icon="CloudArrowUp24" />
        </StackPanel>
    </Grid>
</UserControl>
