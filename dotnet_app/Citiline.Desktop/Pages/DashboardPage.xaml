<Page x:Class="Citiline.Desktop.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      Title="Dashboard">
    <Page.Resources>
        <!-- Stat card hover animation style -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="20" ShadowDepth="2" Direction="270" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuickAction" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Btn" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" 
                                CornerRadius="10" Padding="14,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Btn" Property="Background" Value="#F1F5F9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Btn" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F8FAFC">
        <Grid Margin="36,32,36,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- Header -->
                <RowDefinition Height="Auto" />  <!-- Stat cards -->
                <RowDefinition Height="Auto" />  <!-- Chart + actions row -->
                <RowDefinition Height="Auto" />  <!-- Recent invoices -->
            </Grid.RowDefinitions>

            <!-- ── Header ─────────────────────────────────────────── -->
            <Grid Grid.Row="0" Margin="0,0,0,28">
                <StackPanel>
                    <TextBlock Text="Executive Overview" FontSize="28" FontWeight="Black" Foreground="#0F172A" />
                    <TextBlock x:Name="DateLabel" FontSize="13" Foreground="#64748B" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Background="#F0FDF4" CornerRadius="8" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#22C55E" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="FBR: Compliant" FontSize="12" FontWeight="SemiBold" Foreground="#166534" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ui:Button Content="New Invoice" Appearance="Primary" Margin="12,0,0,0" Click="CreateInvoice_Click">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="Add24" /></ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Grid>

            <!-- ── 4 Stat Cards ───────────────────────────────────── -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,24">

                <!-- Revenue -->
                <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#6D28D9" Offset="0" />
                            <GradientStop Color="#8B5CF6" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Margin="22,18">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Background="#FFFFFF22" CornerRadius="8" Width="36" Height="36">
                                <ui:SymbolIcon Symbol="Money24" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Monthly Revenue" FontSize="12" Foreground="#C4B5FD" />
                        <TextBlock x:Name="RevenueValue" Text="₨ 0" FontSize="26" FontWeight="Black" Foreground="White" Margin="0,4,0,2" />
                        <TextBlock x:Name="RevenueTrend" Text="vs last month" FontSize="11" Foreground="#C4B5FD" />
                    </StackPanel>
                </Border>

                <!-- Invoices -->
                <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0369A1" Offset="0" />
                            <GradientStop Color="#0EA5E9" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Margin="22,18">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Background="#FFFFFF22" CornerRadius="8" Width="36" Height="36">
                                <ui:SymbolIcon Symbol="DocumentText24" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Total Invoices" FontSize="12" Foreground="#7DD3FC" />
                        <TextBlock x:Name="CampaignValue" Text="0" FontSize="26" FontWeight="Black" Foreground="White" Margin="0,4,0,2" />
                        <TextBlock x:Name="CampaignPending" Text="0 pending" FontSize="11" Foreground="#7DD3FC" />
                    </StackPanel>
                </Border>

                <!-- Customers -->
                <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#047857" Offset="0" />
                            <GradientStop Color="#10B981" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Margin="22,18">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Background="#FFFFFF22" CornerRadius="8" Width="36" Height="36">
                                <ui:SymbolIcon Symbol="People24" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Total Clients" FontSize="12" Foreground="#6EE7B7" />
                        <TextBlock x:Name="CustomerValue" Text="0" FontSize="26" FontWeight="Black" Foreground="White" Margin="0,4,0,2" />
                        <TextBlock x:Name="CustomerStatus" Text="Active accounts" FontSize="11" Foreground="#6EE7B7" />
                    </StackPanel>
                </Border>

                <!-- FBR -->
                <Border Style="{StaticResource StatCard}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#B45309" Offset="0" />
                            <GradientStop Color="#F59E0B" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Margin="22,18">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Background="#FFFFFF22" CornerRadius="8" Width="36" Height="36">
                                <ui:SymbolIcon Symbol="ShieldCheckmark24" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="FBR Sync" FontSize="12" Foreground="#FDE68A" />
                        <TextBlock x:Name="PralValue" Text="0% Sync" FontSize="26" FontWeight="Black" Foreground="White" Margin="0,4,0,2" />
                        <TextBlock x:Name="PralSummary" Text="Checking..." FontSize="11" Foreground="#FDE68A" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ── Chart + Quick Actions ──────────────────────────── -->
            <Grid Grid.Row="2" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <!-- Revenue Chart card -->
                <Border Grid.Column="0" Background="White" CornerRadius="14" Margin="0,0,16,0" Padding="24,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="20" ShadowDepth="2" Direction="270" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="260" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Revenue Trend" FontSize="16" FontWeight="Bold" Foreground="#0F172A" />
                                <TextBlock Text="Last 6 months performance" FontSize="12" Foreground="#94A3B8" />
                            </StackPanel>
                        </StackPanel>
                        <lvc:CartesianChart x:Name="RevenueChart" Grid.Row="1" />
                    </Grid>
                </Border>

                <!-- Quick Actions + Employees card -->
                <StackPanel Grid.Column="1">
                    <Border Background="White" CornerRadius="14" Padding="20" Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="20" ShadowDepth="2" Direction="270" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Quick Actions" FontSize="15" FontWeight="Bold" Margin="0,0,0,16" />
                            <Button Style="{StaticResource QuickAction}" Click="CreateInvoice_Click" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Add24" Margin="0,0,10,0" Foreground="#7C3AED" />
                                    <TextBlock Text="New Invoice" VerticalAlignment="Center" FontSize="13" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuickAction}" Click="AddCustomer_Click" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="PersonAdd24" Margin="0,0,10,0" Foreground="#0369A1" />
                                    <TextBlock Text="Add Client" VerticalAlignment="Center" FontSize="13" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuickAction}" Click="RecordPayment_Click" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Money24" Margin="0,0,10,0" Foreground="#047857" />
                                    <TextBlock Text="Record Payment" VerticalAlignment="Center" FontSize="13" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuickAction}" Click="PrintReports_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="DocumentText24" Margin="0,0,10,0" Foreground="#B45309" />
                                    <TextBlock Text="Print Reports" VerticalAlignment="Center" FontSize="13" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- System Status -->
                    <Border Background="White" CornerRadius="14" Padding="20">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="20" ShadowDepth="2" Direction="270" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="System Status" FontSize="15" FontWeight="Bold" Margin="0,0,0,14" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Ellipse Width="8" Height="8" Fill="#22C55E" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Database" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="Online" FontSize="12" Foreground="#22C55E" HorizontalAlignment="Right" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Ellipse Width="8" Height="8" Fill="#22C55E" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="QR Engine" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="Active" FontSize="12" Foreground="#22C55E" HorizontalAlignment="Right" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#F59E0B" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="FBR PRAL" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="Office IP" FontSize="12" Foreground="#F59E0B" HorizontalAlignment="Right" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ── Recent Invoices table ──────────────────────────── -->
            <Border Grid.Row="3" Background="White" CornerRadius="14" Padding="24,20">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="20" ShadowDepth="2" Direction="270" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Recent Invoices" FontSize="16" FontWeight="Bold" Foreground="#0F172A" />
                            <TextBlock Text="Latest billing activity" FontSize="12" Foreground="#94A3B8" />
                        </StackPanel>
                        <ui:Button Content="View All" HorizontalAlignment="Right" VerticalAlignment="Center" Click="CreateInvoice_Click" />
                    </Grid>
                    <DataGrid Grid.Row="1" x:Name="RecentInvoicesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9" RowHeight="46" RowHeaderWidth="0" MaxHeight="220">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="11" />
                                <Setter Property="Padding" Value="0,0,0,10" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="#F1F5F9" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="INVOICE" Binding="{Binding InvoiceNumber}" Width="100" />
                            <DataGridTextColumn Header="CLIENT" Binding="{Binding CustomerName}" Width="*" />
                            <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat=dd MMM yyyy}" Width="120" />
                            <DataGridTextColumn Header="AMOUNT" Binding="{Binding Total, StringFormat=₨ {0:N0}}" Width="130" />
                            <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

        </Grid>
    </ScrollViewer>
</Page>
