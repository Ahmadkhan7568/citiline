<Page x:Class="Citiline.Desktop.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Settings">
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Settings Left Nav -->
        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <StackPanel Margin="16,32,16,0">
                <TextBlock Text="Settings" FontSize="22" FontWeight="Black" Margin="8,0,0,24" />
                <ListBox x:Name="SettingsNav" BorderThickness="0" Background="Transparent"
                         SelectionChanged="SettingsNav_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,10" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="B" Background="Transparent" CornerRadius="8" Padding="12,9">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="B" Property="Background" Value="#EDE9FE" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="B" Property="Background" Value="#F1F5F9" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBoxItem Tag="global" IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" Margin="0,0,10,0" />
                            <TextBlock Text="Global Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="fbr">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ShieldCheckmark24" Margin="0,0,10,0" />
                            <TextBlock Text="FBR / PRAL" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="invoice">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DocumentText24" Margin="0,0,10,0" />
                            <TextBlock Text="Invoice Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="appearance">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="PaintBrush24" Margin="0,0,10,0" />
                            <TextBlock Text="Appearance" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="users">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="People24" Margin="0,0,10,0" />
                            <TextBlock Text="User Management" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="license">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Key24" Margin="0,0,10,0" />
                            <TextBlock Text="License" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- Settings Content Area -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,32,40,40">

                <!-- Global Settings Panel -->
                <StackPanel x:Name="PanelGlobal">
                    <TextBlock Text="Global Settings" FontSize="24" FontWeight="Black" Margin="0,0,0,4" />
                    <TextBlock Text="Agency information and system-wide configuration" Foreground="#64748B" Margin="0,0,0,32" />

                    <TextBlock Text="Agency Details" FontSize="14" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,16" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Agency Name" FontSize="12" Foreground="#64748B" Margin="0,0,0,6" />
                            <ui:TextBox x:Name="AgencyName" Text="Citiline Advertising" Height="36" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="NTN Number" FontSize="12" Foreground="#64748B" Margin="0,0,0,6" />
                            <ui:TextBox x:Name="AgencyNTN" Text="1958264-1" Height="36" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Phone" FontSize="12" Foreground="#64748B" Margin="0,0,0,6" />
                            <ui:TextBox x:Name="AgencyPhone" Text="051-2605859" Height="36" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Email" FontSize="12" Foreground="#64748B" Margin="0,0,0,6" />
                            <ui:TextBox x:Name="AgencyEmail" Text="info@citiline.com.pk" Height="36" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="Office Address" FontSize="12" Foreground="#64748B" Margin="0,0,0,6" />
                        <ui:TextBox x:Name="AgencyAddress" Text="Office No. 10/B, Black Horse Plaza, Fazal-e-Haq Road, Blue Area, Islamabad" Height="36" />
                    </StackPanel>

                    <TextBlock Text="GST Details" FontSize="14" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,16" />
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="GST Registration No." FontSize="12" Foreground="#64748B" Margin="0,0,0,6" />
                            <ui:TextBox Text="26-00-8442-250-73" Height="36" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Default GST Rate (%)" FontSize="12" Foreground="#64748B" Margin="0,0,0,6" />
                            <ui:TextBox Text="18" Height="36" />
                        </StackPanel>
                    </Grid>
                    <ui:Button Content="Save Global Settings" Appearance="Primary" Click="SaveGlobal_Click" />
                </StackPanel>

                <!-- FBR Panel -->
                <StackPanel x:Name="PanelFbr" Visibility="Collapsed">
                    <TextBlock Text="FBR / PRAL Settings" FontSize="24" FontWeight="Black" Margin="0,0,0,4" />
                    <TextBlock Text="Federal Board of Revenue integration and compliance configuration" Foreground="#64748B" Margin="0,0,0,32" />

                    <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="⚠ FBR PRAL v1.12 Compliance" FontWeight="Bold" Foreground="#C2410C" />
                            <TextBlock Text="FBR submission requires your office IP to be whitelisted with PRAL. Contact FBR support if you experience connectivity issues." Foreground="#9A3412" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Connection Settings" FontSize="14" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,16" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="PRAL Endpoint URL" FontSize="12" Foreground="#64748B" Margin="0,0,0,6" />
                            <ui:TextBox Text="https://fbr.gov.pk/pral/api/v1" Height="36" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="STRN / Registration No." FontSize="12" Foreground="#64748B" Margin="0,0,0,6" />
                            <ui:TextBox Text="26-00-8442-250-73" Height="36" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="API Key / Token" FontSize="12" Foreground="#64748B" Margin="0,0,0,6" />
                        <ui:PasswordBox PlaceholderText="Enter FBR API Key..." Height="36" />
                    </StackPanel>

                    <TextBlock Text="Sync Options" FontSize="14" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,16" />
                    <CheckBox Content="Auto-sync invoices to FBR on save" IsChecked="True" Margin="0,0,0,8" />
                    <CheckBox Content="Include QR Code in all invoices" IsChecked="True" Margin="0,0,0,24" />

                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="Test FBR Connection" Margin="0,0,12,0" />
                        <ui:Button Content="Save FBR Settings" Appearance="Primary" Click="SaveFbr_Click" />
                    </StackPanel>
                </StackPanel>

                <!-- Invoice Settings Panel -->
                <StackPanel x:Name="PanelInvoice" Visibility="Collapsed">
                    <TextBlock Text="Invoice Settings" FontSize="24" FontWeight="Black" Margin="0,0,0,4" />
                    <TextBlock Text="Default values and format for all invoices" Foreground="#64748B" Margin="0,0,0,32" />

                    <TextBlock Text="Default Invoice Terms" FontSize="14" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,16" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Payment Terms (days)" FontSize="12" Foreground="#64748B" Margin="0,0,0,6" />
                            <ui:TextBox Text="7" Height="36" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Invoice Prefix" FontSize="12" Foreground="#64748B" Margin="0,0,0,6" />
                            <ui:TextBox Text="INV-" Height="36" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Bank Details (Print on Invoice)" FontSize="12" Foreground="#64748B" Margin="0,0,0,6" />
                        <ui:TextBox Text="Bank Al Falah A/C No. 5504 5000 284450" Height="36" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="Invoice Footer Note" FontSize="12" Foreground="#64748B" Margin="0,0,0,6" />
                        <ui:TextBox Text="Please issue cheque in favour of 'CITILINE ADVERTISING' only." Height="36" />
                    </StackPanel>
                    <CheckBox Content="Show GST breakdown on invoice" IsChecked="True" Margin="0,0,0,8" />
                    <CheckBox Content="Show FBR QR Code on invoice" IsChecked="True" Margin="0,0,0,24" />
                    <ui:Button Content="Save Invoice Settings" Appearance="Primary" Click="SaveInvoice_Click" />
                </StackPanel>

                <!-- Appearance Panel -->
                <StackPanel x:Name="PanelAppearance" Visibility="Collapsed">
                    <TextBlock Text="Appearance" FontSize="24" FontWeight="Black" Margin="0,0,0,4" />
                    <TextBlock Text="Customize the look and feel of the application" Foreground="#64748B" Margin="0,0,0,32" />

                    <TextBlock Text="Theme" FontSize="14" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,16" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <RadioButton Content="Light Mode" IsChecked="True" Margin="0,0,24,0" />
                        <RadioButton Content="Dark Mode" />
                    </StackPanel>

                    <TextBlock Text="Accent Color" FontSize="14" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,16" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Border Width="40" Height="40" Background="#7C3AED" CornerRadius="6" Margin="0,0,8,0" />
                        <Border Width="40" Height="40" Background="#2563EB" CornerRadius="6" Margin="0,0,8,0" />
                        <Border Width="40" Height="40" Background="#059669" CornerRadius="6" Margin="0,0,8,0" />
                        <Border Width="40" Height="40" Background="#DC2626" CornerRadius="6" />
                    </StackPanel>

                    <TextBlock Text="Sidebar Width" FontSize="14" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,16" />
                    <ComboBox Width="200" HorizontalAlignment="Left" Margin="0,0,0,24">
                        <ComboBoxItem Content="Compact (200px)" />
                        <ComboBoxItem Content="Default (260px)" IsSelected="True" />
                        <ComboBoxItem Content="Wide (320px)" />
                    </ComboBox>
                    <ui:Button Content="Apply Appearance" Appearance="Primary" />
                </StackPanel>

                <!-- User Management Panel -->
                <StackPanel x:Name="PanelUsers" Visibility="Collapsed">
                    <TextBlock Text="User Management" FontSize="24" FontWeight="Black" Margin="0,0,0,4" />
                    <TextBlock Text="Manage access and roles for ERP users" Foreground="#64748B" Margin="0,0,0,32" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <ui:Button Content="Add New User" Appearance="Primary">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="PersonAdd24" /></ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>

                    <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                        <DataGrid AutoGenerateColumns="False" IsReadOnly="True" Background="White" BorderThickness="0"
                                  GridLinesVisibility="Horizontal" RowHeight="44" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Username" Width="*" />
                                <DataGridTextColumn Header="Full Name" Width="200" />
                                <DataGridTextColumn Header="Role" Width="120" />
                                <DataGridTextColumn Header="Last Login" Width="150" />
                                <DataGridTextColumn Header="Status" Width="100" />
                            </DataGrid.Columns>
                            <DataGrid.Items>
                                <x:Array Type="sys:String" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                </x:Array>
                            </DataGrid.Items>
                        </DataGrid>
                    </Border>
                </StackPanel>

                <!-- License Panel -->
                <StackPanel x:Name="PanelLicense" Visibility="Collapsed">
                    <TextBlock Text="License &amp; Activation" FontSize="24" FontWeight="Black" Margin="0,0,0,4" />
                    <TextBlock Text="Software license details and activation status" Foreground="#64748B" Margin="0,0,0,32" />

                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="✓ Software Activated" FontSize="16" FontWeight="Bold" Foreground="#166534" />
                            <TextBlock Text="Citiline ERP Suite - Professional Edition" Foreground="#15803D" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Registered To" FontSize="12" Foreground="#64748B" Margin="0,0,0,6" />
                            <ui:TextBox Text="Citiline Advertising" IsReadOnly="True" Height="36" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="License Type" FontSize="12" Foreground="#64748B" Margin="0,0,0,6" />
                            <ui:TextBox Text="Professional (Unlimited)" IsReadOnly="True" Height="36" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="License Key" FontSize="12" Foreground="#64748B" Margin="0,0,0,6" />
                        <ui:TextBox Text="CITI-PRO-XXXX-XXXX-XXXX" IsReadOnly="True" Height="36" />
                    </StackPanel>
                    <ui:Button Content="Check for Updates" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
