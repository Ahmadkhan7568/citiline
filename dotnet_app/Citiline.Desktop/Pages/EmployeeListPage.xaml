<Page x:Class="Citiline.Desktop.Pages.EmployeeListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Employee Management">
    <Grid Margin="32" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="HR &amp; Recruitment" FontSize="32" FontWeight="Black" />
            <TextBlock Text="Agency Employee Directory &amp; Payroll Base" FontSize="14" Foreground="#64748B" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <ui:Button Content="Add New Employee" Appearance="Primary" Margin="0,0,12,0">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="PersonAdd24" />
                </ui:Button.Icon>
            </ui:Button>
            <ui:TextBox PlaceholderText="Search employees..." Width="300" />
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
            <Grid>
                <DataGrid x:Name="EmployeesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="White" BorderThickness="0" GridLinesVisibility="Horizontal"
                          RowHeight="44" HorizontalGridLinesBrush="#F1F5F9" RowHeaderWidth="0">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC" />
                            <Setter Property="Foreground" Value="#64748B" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Padding" Value="16,10" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="#E2E8F0" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="*" />
                        <DataGridTextColumn Header="Designation" Binding="{Binding Designation}" Width="200" />
                        <DataGridTextColumn Header="Monthly Salary" Binding="{Binding Salary, StringFormat=₨ {0:N0}}" Width="150" />
                        <DataGridTextColumn Header="Join Date" Binding="{Binding JoinDate, StringFormat=yyyy-MM-dd}" Width="130" />
                        <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="130" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="NoDataText" Text="No employee records found. Click 'Add New Employee' to get started."
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60,0,0" Opacity="0.5" />
            </Grid>
        </Border>
    </Grid>
</Page>
