<Page x:Class="Citiline.Desktop.Pages.InvoiceEditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Invoice Editor">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="*" />    <!-- Content -->
            <RowDefinition Height="Auto" /> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Target Template Header -->
        <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="40,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <Image Source="/Assets/logo.png" Width="180" Height="60" Margin="0,0,20,0" VerticalAlignment="Center" />
                    
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="SALES TAX INVOICE" FontSize="20" FontWeight="Black" Foreground="#0F172A" Margin="0,0,0,15" />
                        <Grid Width="300" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="INVOICE NO." FontWeight="Bold" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,10,5" />
                        <ui:TextBox x:Name="InvoiceNumberBox" Grid.Row="0" Grid.Column="1" Height="30" Margin="0,0,0,5" />

                        <TextBlock Text="DATE:" FontWeight="Bold" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <DatePicker x:Name="InvoiceDatePicker" Grid.Row="1" Grid.Column="1" Height="30" />
                    </Grid>
                </StackPanel>
                </Grid>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="CITILINE ADVERTISING" FontSize="18" FontWeight="Black" TextAlignment="Right" />
                    <TextBlock Text="Office No. 10/B, Black Horse Plaza," FontSize="11" TextAlignment="Right" />
                    <TextBlock Text="Fazal-e-Haq Road, Blue Area, Islamabad" FontSize="11" TextAlignment="Right" />
                    <TextBlock Text="Tel: 051-2605859" FontSize="11" TextAlignment="Right" />
                    <TextBlock Text="NTN No. 1958264-1" FontSize="11" FontWeight="Bold" Margin="0,5,0,0" TextAlignment="Right" />
                    <TextBlock Text="GST No. 26-00-8442-250-73" FontSize="11" FontWeight="Bold" TextAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Part -->
        <ScrollViewer Grid.Row="1" Padding="40,30">
            <StackPanel>
                <!-- TO: Section -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="TO:" FontWeight="Black" FontSize="20" VerticalAlignment="Center" Margin="0,0,15,0" />
                    <ComboBox x:Name="CustomerCombo" Grid.Column="1" DisplayMemberPath="CompanyName" SelectedValuePath="Id" Height="40" VerticalAlignment="Center" BorderThickness="2" BorderBrush="Black" />
                </Grid>

                <!-- Line Items Table (The 80% Work) -->
                <DataGrid x:Name="ItemsGrid" AutoGenerateColumns="False" CanUserAddRows="True" 
                          Background="White" BorderBrush="Black" BorderThickness="1" GridLinesVisibility="All" 
                          HeadersVisibility="Column" RowHeight="35">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F1F5F9" />
                            <Setter Property="Foreground" Value="Black" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Padding" Value="10,5" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="BorderBrush" Value="Black" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                        <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                        <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="120" IsReadOnly="True" />
                        <DataGridTextColumn Header="GST 18%" Binding="{Binding GstAmount, StringFormat=N2}" Width="100" IsReadOnly="True" />
                        <DataGridTextColumn Header="Total with GST" Binding="{Binding TotalWithGst, StringFormat=N2}" Width="150" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Quick Buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,10">
                    <ui:Button Content="Add Line Item" Click="AddLine_Click" Icon="{ui:SymbolIcon Add24}" Margin="0,0,10,0" />
                    <ui:Button Content="Calculate Totals" Click="CalculateTotals_Click" Icon="{ui:SymbolIcon Calculator24}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Target Template Footer -->
        <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="40,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Payment within 7 days." FontSize="12" FontWeight="Bold" />
                    <TextBlock Text="please issue cheque in favour of 'CITILINE ADVERTISING' only." FontSize="11" FontStyle="Italic" />
                    <TextBlock Text="Bank Al Falah A/C No. 5504 5000 284450" FontSize="11" Margin="0,5,0,0" />
                    <TextBlock Text="for Citiline Advertising" FontWeight="Bold" Margin="0,20,0,0" HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <Image x:Name="QrCodeImage" Width="100" Height="100" Margin="0,0,20,0" Grid.Column="0" HorizontalAlignment="Left" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Total Payable" FontWeight="Black" FontSize="18" Margin="0,0,0,5" />
                            <ui:TextBox x:Name="GrandTotalBox" Text="0.00" Height="40" IsReadOnly="True" FontWeight="Black" FontSize="20" HorizontalContentAlignment="Right" BorderThickness="3" BorderBrush="Black" />
                        </StackPanel>
                    </Grid>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Right">
                        <ui:Button Content="Cancel" Margin="0,0,12,0" Click="Cancel_Click" />
                        <ui:Button Content="SAVE &amp; GENERATE QR" Appearance="Primary" Width="220" Click="SaveInvoice_Click" Icon="{ui:SymbolIcon Checkmark24}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
