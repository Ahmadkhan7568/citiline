<Page x:Class="Citiline.Desktop.Pages.CustomersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Customer Management">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Customer Management" FontSize="32" FontWeight="Black" />
            <TextBlock Text="Manage your client database and advertising partners" FontSize="14" Foreground="#64748B" />
        </StackPanel>

        <ui:CardControl Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                    <ui:Button Content="Add Customer" Appearance="Primary" Margin="0,0,12,0" Click="AddCustomer_Click">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="PersonAdd24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:TextBox PlaceholderText="Search customers..." Width="300" />
                </StackPanel>

                <DataGrid Grid.Row="1" x:Name="CustomersGrid" AutoGenerateColumns="False" 
                          IsReadOnly="True" Background="Transparent" BorderThickness="0"
                          GridLinesVisibility="None" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Company Name" Binding="{Binding CompanyName}" Width="*" />
                        <DataGridTextColumn Header="NTN" Binding="{Binding NTN}" Width="150" />
                        <DataGridTextColumn Header="Contact" Binding="{Binding ContactPerson}" Width="150" />
                        <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="120" />
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </ui:CardControl>
    </Grid>
</Page>
