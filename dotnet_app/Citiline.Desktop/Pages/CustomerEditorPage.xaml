<Page x:Class="Citiline.Desktop.Pages.CustomerEditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Customer Editor">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="New Customer Registration" FontSize="32" FontWeight="Black" />
            <TextBlock Text="Register a new advertising partner in the system" FontSize="14" Foreground="#64748B" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ui:CardControl Padding="32">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Left -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Company Name" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ui:TextBox x:Name="CompanyNameBox" PlaceholderText="e.g. Blue Moon Marketing" Margin="0,0,0,20" />

                        <TextBlock Text="NTN Number" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ui:TextBox x:Name="NtnBox" PlaceholderText="1234567-8" Margin="0,0,0,20" />

                        <TextBlock Text="Contact Person" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ui:TextBox x:Name="ContactBox" PlaceholderText="Full Name" Margin="0,0,0,20" />
                    </StackPanel>

                    <!-- Right -->
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock Text="Phone Number" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ui:TextBox x:Name="PhoneBox" PlaceholderText="0300-0000000" Margin="0,0,0,20" />

                        <TextBlock Text="Email Address" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ui:TextBox x:Name="EmailBox" PlaceholderText="client@example.com" Margin="0,0,0,20" />

                        <TextBlock Text="Office Address" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ui:TextBox x:Name="AddressBox" PlaceholderText="Full physical address" Margin="0,0,0,20" />
                    </StackPanel>
                </Grid>
            </ui:CardControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <ui:Button Content="Cancel" Margin="0,0,12,0" Click="Cancel_Click" />
            <ui:Button Content="Register Customer" Appearance="Primary" Width="200" Click="SaveCustomer_Click">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Checkmark24" />
                </ui:Button.Icon>
            </ui:Button>
        </StackPanel>
    </Grid>
</Page>
