<Window x:Class="Citiline.Desktop.Views.FirstTimeSetupView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
        Title="Citiline ERP - Setup" 
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="System Initialization" />

        <Border Grid.Row="1" Padding="60,40">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Progress Steps -->
                <StackPanel Grid.Column="0" Margin="0,0,40,0">
                    <TextBlock Text="Initial Setup" FontSize="32" FontWeight="Black" Margin="0,0,0,40" />
                    
                    <ui:MenuItem Header="Database Configuration" IsEnabled="True" Margin="0,0,0,10">
                        <ui:MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Database24" />
                        </ui:MenuItem.Icon>
                    </ui:MenuItem>
                    <ui:MenuItem Header="Agency Details" IsEnabled="False" Margin="0,0,0,10">
                        <ui:MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Building24" />
                        </ui:MenuItem.Icon>
                    </ui:MenuItem>
                    <ui:MenuItem Header="Admin Account" IsEnabled="False" Margin="0,0,0,10">
                        <ui:MenuItem.Icon>
                            <ui:SymbolIcon Symbol="PersonStar24" />
                        </ui:MenuItem.Icon>
                    </ui:MenuItem>
                </StackPanel>

                <!-- Right: Step Content (Database Setup) -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Configure Database" FontSize="20" FontWeight="Bold" Margin="0,0,0,8" />
                    <TextBlock Text="We will initialize a local SQLite database for your agency data." Foreground="#64748B" Margin="0,0,0,32" />

                    <TextBlock Text="Data Storage Path" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="D:\citiline\data\citiline.db" IsReadOnly="True" />
                        <ui:Button Grid.Column="1" Content="Browse" Margin="8,0,0,0" />
                    </Grid>

                    <ui:InfoBar Title="Safe Initialization" 
                                Message="The system will verify the data path and create necessary tables." 
                                Severity="Informational" 
                                IsOpen="True" 
                                Margin="0,0,0,32" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="Cancel" Margin="0,0,12,0" />
                        <ui:Button Content="Initialize &amp; Continue" Appearance="Primary" Icon="ArrowRight24" />
                    </StackPanel>

                    <TextBlock Text="Developed by Ahmadkhan" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right" Margin="0,100,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
