<ui:FluentWindow x:Class="Citiline.Desktop.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Citiline ERP - Login" 
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!-- Left Side: Branding / Background -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F172A" Offset="0" />
                    <GradientStop Color="#1E293B" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="CITILINE" FontSize="48" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" />
                <TextBlock Text="ADVERTISING AGENCY ERP" FontSize="14" FontWeight="SemiBold" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,10,0,0" />
                <ui:SymbolIcon Symbol="Shapes24" FontSize="120" Foreground="White" Opacity="0.1" Margin="0,40,0,0" />
            </StackPanel>
        </Border>

        <!-- Right Side: Login Form -->
        <Border Grid.Column="1" Background="White" Padding="40" VerticalAlignment="Stretch">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Welcome Back" FontSize="28" FontWeight="Bold" Foreground="#1E293B" />
                <TextBlock Text="Please sign in to continue to Citiline" FontSize="14" Foreground="#64748B" Margin="0,8,0,32" />

                <TextBlock Text="Username" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8" />
                <ui:TextBox x:Name="UsernameBox" PlaceholderText="Enter your username" Margin="0,0,0,16">
                    <ui:TextBox.Icon>
                        <ui:SymbolIcon Symbol="Person24" />
                    </ui:TextBox.Icon>
                </ui:TextBox>

                <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8" />
                <ui:PasswordBox x:Name="PasswordBox" PlaceholderText="Enter your password" Margin="0,0,0,24" />

                <ui:Button Content="Sign In" Appearance="Primary" Height="40" HorizontalAlignment="Stretch" Margin="0,0,0,16" Click="SignInButton_Click">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowRight24" />
                    </ui:Button.Icon>
                </ui:Button>

                <TextBlock HorizontalAlignment="Center">
                    <Hyperlink Foreground="#38BDF8" FontWeight="SemiBold">Forgot Password?</Hyperlink>
                </TextBlock>

                <Separator Margin="0,40,0,20" Opacity="0.1" />

                <TextBlock Text="Developed by Ahmadkhan" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <ui:TitleBar Grid.ColumnSpan="2" VerticalAlignment="Top" />
    </Grid>
</ui:FluentWindow>
